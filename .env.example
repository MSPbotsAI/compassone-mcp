# Local development only. In production the platform's mcp-gateway injects the
# credential as a request header and none of these are set.

# stdio | http   (the Dockerfile sets http)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# gateway | env
#   gateway — read X-Blackpoint-API-Token from each request (production)
#   env     — use COMPASSONE_API_TOKEN below (local dev only, single-tenant)
AUTH_MODE=gateway

# Only used when AUTH_MODE=env. Placeholder — never commit a real token.
COMPASSONE_API_TOKEN=your-compassone-partner-api-token

# Vendor API base URL. Override only for a non-production CompassOne endpoint.
COMPASSONE_BASE_URL=https://api.blackpointcyber.com
